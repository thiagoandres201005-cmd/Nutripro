{
  "appId": "com.somaai.app",
  "appName": "SomaAi",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0b",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0a0a0b"
    },
    "Camera": {
      "permissions": ["camera"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#00ff88",
      "sound": "beep.wav"
    },
    "BarcodeScanner": {
      "supportedFormats": ["EAN_13", "EAN_8", "UPC_A", "UPC_E", "CODE_128", "CODE_39", "QR_CODE"],
      "detectionThreshold": 0.5
    }
  },
  "android": {
    "backgroundColor": "#0a0a0b"
  }
}
